<?php

namespace App\Http\Controllers;

use App\Models\NetworkMnc;

use App\Http\Controllers\Controller;
use App\Models\Network;
use App\Models\Country;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Str;

class NetworksController extends Controller
{
    /**
     * Display a listing of the networks.
     */
    public function index(Request $request)
    {
        $q         = trim((string) $request->input('q', ''));
        $countryId = $request->input('country_id');
        $mccmnc    = trim((string) $request->input('mccmnc', ''));
        $perPage   = (int) $request->input('per_page', 25);
        $sort      = $request->input('sort', 'country'); // country | name
        $direction = strtolower($request->input('direction', 'asc')) === 'desc' ? 'desc' : 'asc';

        if ($perPage <= 0 || $perPage > 200) {
            $perPage = 25;
        }

        $query = Network::query()
            ->with(['country', 'mncs', 'meta']);

        // Filter by name / search string
        if ($q !== '') {
            $lower = Str::lower($q);
            $query->where(function ($sub) use ($q, $lower) {
                $sub->where('name', 'ILIKE', '%' . $q . '%')
                    ->orWhere('lower_name', 'ILIKE', '%' . $lower . '%');
            });
        }

        // Filter by country
        if ($countryId !== null && $countryId !== '') {
            $query->where('country_id', (int) $countryId);
        }

        // Filter by MCC/MNC
        if ($mccmnc !== '') {
            $query->whereHas('mncs', function ($sub) use ($mccmnc) {
                $sub->where('mcc', 'LIKE', '%' . $mccmnc . '%')
                    ->orWhere('mnc', 'LIKE', '%' . $mccmnc . '%');
            });
        }

        // Sorting
        if ($sort === 'name') {
            $query->orderBy('name', $direction)->orderBy('id');
        } else {
            // Default: sort by country name then network name
            $query->leftJoin('countries', 'networks.country_id', '=', 'countries.id')
                  ->select('networks.*')
                  ->orderBy('countries.name', $direction)
                  ->orderBy('networks.name', $direction);
        }

        $networks = $query->paginate($perPage)->withQueryString();

        $countries = Country::orderBy('name')->get();

        return view('networks.index', [
            'networks'  => $networks,
            'countries' => $countries,
            'filters'   => [
                'q'         => $q,
                'country_id'=> $countryId,
                'mccmnc'    => $mccmnc,
                'per_page'  => $perPage,
                'sort'      => $sort,
                'direction' => $direction,
            ],
        ]);
    }

    /**
     * Show the form for creating a new network.
     */
    public function create()
    {
        $countries = Country::orderBy('name')->get();

        return view('networks.create', [
            'countries' => $countries,
        ]);
    }

    /**
     * Store a newly created network in storage.
     */
    public function store(Request $request)
    {
        $name = trim((string) $request->input('name', ''));

        if ($name === '') {
            return back()->withInput()->withErrors([
                'name' => 'Name is required.',
            ]);
        }

        $countryId = null;
        if ($request->has('country_id')) {
            $raw = $request->input('country_id');
            if ($raw !== null && $raw !== '') {
                if (is_numeric($raw)) {
                    $candidate = (int) $raw;
                } else {
                    if (preg_match('/(\d+)/', (string) $raw, $m)) {
                        $candidate = (int) $m[1];
                    } else {
                        $candidate = null;
                    }
                }

                if ($candidate !== null && Country::whereKey($candidate)->exists()) {
                    $countryId = $candidate;
                }
            }
        }

        $network = new Network();
        $network->name       = $name;
        $network->lower_name = Str::lower($name);
        $network->country_id = $countryId;
        $network->save();

        return redirect()
            ->route('networks.edit', $network)
            ->with('success', 'Network created successfully.');
    }

    /**
     * Show the form for editing the specified network.
     */
    public function edit(Network $network)
    {
        $countries = Country::orderBy('name')->get();
        $network->loadMissing(['mncs', 'country', 'meta']);

        return view('networks.edit', [
            'network'   => $network,
            'countries' => $countries,
        ]);
    }

    /**
     * Update the specified network in storage.
     *
     * IMPORTANT:
     * - Only updates the Network row (name, lower_name, country_id).
     * - Does NOT touch MCC/MNC assignments (network_mncs).
     */
    public function update(Request $request, Network $network)
    {
        $action = $request->input('action', 'save');

        $data = $request->validate([
            'name'       => ['required', 'string', 'max:255'],
            'country_id' => ['nullable', 'integer', 'exists:countries,id'],
            'new_mcc'    => ['nullable', 'string', 'max:3'],
            'new_mnc'    => ['nullable', 'string', 'max:3'],
        ]);

        // Basic network fields
        $network->name       = $data['name'];
        $network->lower_name = Str::lower($data['name']);
        $network->country_id = $data['country_id'] ?? null;
        $network->save();

        // Handle add-MNC action (does NOT touch existing MNCs)
        if ($action === 'add_mnc' && !empty($data['new_mnc'])) {
            $mcc = $data['new_mcc'] ?? null;

            // If MCC not provided from form, derive from first existing pair if any
            if ($mcc === null || $mcc === '') {
                $first = $network->mncs()->first();
                $mcc   = $first?->mcc;
            }

            if ($mcc) {
                $cleanMnc = trim($data['new_mnc']);
                // normalize: drop leading zeros but keep at least one digit
                $cleanMnc = ltrim($cleanMnc, '0');
                if ($cleanMnc === '') {
                    $cleanMnc = '0';
                }

                NetworkMnc::firstOrCreate([
                    'network_id' => $network->id,
                    'mcc'        => $mcc,
                    'mnc'        => $cleanMnc,
                ]);
            }
        }

        $msg = $action === 'add_mnc'
            ? 'Network updated & MNC added.'
            : 'Network updated.';

        return redirect()
            ->route('networks.edit', $network)
            ->with('success', $msg);
    }
        $name = trim($name);

        if ($name === '') {
            // keep previous name if form didn't send a valid one
            $name = $network->name ?? '';
        }

        // Country: try to read country_id in a robust way
        $countryId = $network->country_id;

        if ($request->has('country_id')) {
            $raw = $request->input('country_id');

            if ($raw === null || $raw === '') {
                // Explicitly cleared
                $countryId = null;
            } else {
                if (is_numeric($raw)) {
                    $candidate = (int) $raw;
                } else {
                    if (preg_match('/(\d+)/', (string) $raw, $m)) {
                        $candidate = (int) $m[1];
                    } else {
                        $candidate = null;
                    }
                }

                if ($candidate !== null && Country::whereKey($candidate)->exists()) {
                    $countryId = $candidate;
                }
                // if invalid, we silently keep the old $countryId
            }
        }

        $network->name       = $name;
        $network->lower_name = Str::lower($name);
        $network->country_id = $countryId;
        $network->save();

        return redirect()
            ->route('networks.edit', $network)
            ->with('success', 'Network updated.');
    }

    /**
     * Remove the specified network from storage.
     */
    public function destroy(Network $network)
    {
        $network->delete();

        return redirect()
            ->route('networks.index')
            ->with('success', 'Network deleted successfully.');
    }
}
