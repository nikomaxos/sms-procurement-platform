<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;

class SupplierOffer extends Model
{
    use HasFactory;

    // Μαζική αντιστοίχιση (κρατάμε το validation στον Controller)
    protected $guarded = [];

    protected $casts = [
        'price'          => 'decimal:6',
        'is_exclusive'   => 'boolean',
        'effective_date' => 'date',
    ];

    // =========================
    //  RELATIONS
    // =========================

    public function country()
    {
        return $this->belongsTo(Country::class);
    }

    public function network()
    {
        return $this->belongsTo(Network::class);
    }

    public function networkMnc()
    {
        return $this->belongsTo(NetworkMnc::class);
    }

    public function supplier()
    {
        return $this->belongsTo(Supplier::class);
    }

    public function supplierConnection()
    {
        return $this->belongsTo(SupplierConnection::class, 'supplier_connection_id');
    }

    /**
     * Alias για το connection (ώστε $offer->connection να παίζει).
     */
    public function connection()
    {
        return $this->belongsTo(SupplierConnection::class, 'supplier_connection_id');
    }

    // =========================
    //  ACCESSORS
    // =========================

    /**
     * Nicely formatted price:
     * 0.030500 -> "0.0305"
     */
    public function getPriceAttribute($value)
    {
        if ($value === null) {
            return null;
        }

        $value = (string) $value;

        if (strpos($value, '.') !== false) {
            $value = rtrim(rtrim($value, '0'), '.');
        }

        return $value;
    }

    /**
     * Ανθρώπινο όνομα connection για τη στήλη "Connection" στο list view.
     */
    public function getConnectionNameAttribute()
    {
        $conn = $this->getRelationValue('connection') ?: $this->getRelationValue('supplierConnection');

        if ($conn instanceof SupplierConnection && isset($conn->name)) {
            return $conn->name;
        }

        if (isset($this->attributes['connection_name']) && is_string($this->attributes['connection_name'])) {
            return $this->attributes['connection_name'];
        }

        if (isset($this->attributes['supplier_connection']) && is_string($this->attributes['supplier_connection'])) {
            return $this->attributes['supplier_connection'];
        }

        return null;
    }

    /**
     * Mutator για να κανονικοποιούμε την τιμή και στο γράψιμο.
     */
    public function setPriceAttribute($value)
    {
        if ($value === null || $value === '') {
            $this->attributes['price'] = null;
            return;
        }

        $num = (float) $value;
        // Κρατάμε μέχρι 6 δεκαδικά, χωρίς περιττά μηδενικά στο string
        $str = rtrim(rtrim(number_format($num, 6, '.', ''), '0'), '.');

        // Αφήνουμε τη DB να το γράψει σαν numeric(10,6)
        $this->attributes['price'] = $str;
    }
}
