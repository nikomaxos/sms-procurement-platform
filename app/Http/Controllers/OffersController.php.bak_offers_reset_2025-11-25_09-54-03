<?php

namespace App\Http\Controllers;

use App\Models\SupplierOffer;
use App\Models\Country;
use App\Models\Network;
use App\Models\NetworkMnc;
use App\Models\Supplier;
use App\Models\SupplierConnection;
use App\Models\DropdownItem;
use Illuminate\Http\Request;

class OffersController extends Controller
{
    /**
     * List offers with simple filters.
     */
    public function index(Request $request)
    {
        $query = SupplierOffer::query()
            ->with([
                'country',
                'network',
                'networkMnc',
                'supplier',
                'connection',
                'productTypeDropdown',
                'knownHopsDropdown',
                'senderIdSupportedDropdown',
            ]);

        // Basic filters
        if ($request->filled('country_id')) {
            $query->where('country_id', $request->input('country_id'));
        }

        if ($request->filled('supplier_id')) {
            $query->where('supplier_id', $request->input('supplier_id'));
        }

        if ($request->filled('network_id')) {
            $query->where('network_id', $request->input('network_id'));
        }

        if ($request->filled('supplier_connection_id')) {
            $query->where('supplier_connection_id', $request->input('supplier_connection_id'));
        }

        if ($request->filled('product_type')) {
            $query->where('product_type', $request->input('product_type'));
        }

        $offers = $query
            ->orderBy('country_id')
            ->orderBy('network_id')
            ->orderBy('supplier_id')
            ->orderBy('price')
            ->paginate(50);

        // Filter options
        $countries   = Country::orderBy('name')->get();
        $suppliers   = Supplier::orderBy('name')->get();
        $networks    = Network::orderBy('name')->get();
        $connections = SupplierConnection::orderBy('name')->get();

        // Distinct product_type values from supplier_offers (υπάρχει η στήλη)
        $productTypeOptions = SupplierOffer::query()
            ->select('product_type')
            ->whereNotNull('product_type')
            ->distinct()
            ->orderBy('product_type')
            ->pluck('product_type');

        // Known Hops & Sender ID Supported: αφήνουμε προς το παρόν κενά collections
        // για να ΜΗΝ γίνεται κανένα query σε ανύπαρκτες στήλες.
        $knownHopsOptions          = collect();
        $senderIdSupportedOptions  = collect();

        return view('offers.index', compact(
            'offers',
            'countries',
            'suppliers',
            'networks',
            'connections',
            'productTypeOptions',
            'knownHopsOptions',
            'senderIdSupportedOptions',
        ));
    }

    /**
     * Show create form.
     */
    public function create()
    {
        $countries   = Country::orderBy('name')->get();
        $suppliers   = Supplier::orderBy('name')->get();
        $networks    = Network::orderBy('name')->get();
        $connections = SupplierConnection::orderBy('name')->get();

        // Dropdown menus (IDs όπως τα έχουμε ορίσει: 1 = Product Type, 2 = Known Hops, 3 = Sender ID Supported)
        $productTypeItems        = DropdownItem::where('dropdown_menu_id', 1)->orderBy('label')->get();
        $knownHopsItems          = DropdownItem::where('dropdown_menu_id', 2)->orderBy('label')->get();
        $senderIdSupportedItems  = DropdownItem::where('dropdown_menu_id', 3)->orderBy('label')->get();

        return view('offers.create', compact(
            'countries',
            'suppliers',
            'networks',
            'connections',
            'productTypeItems',
            'knownHopsItems',
            'senderIdSupportedItems',
        ));
    }

    /**
     * Store new offer.
     */
    public function store(Request $request)
    {
        $data = $request->validate([
            'country_id'                      => ['required', 'integer'],
            'network_id'                      => ['required', 'integer'],
            'network_mnc_id'                  => ['required', 'integer'],
            'supplier_id'                     => ['required', 'integer'],
            'supplier_connection_id'          => ['required', 'integer'],
            'price'                           => ['required', 'numeric'],
            'mcc'                             => ['required', 'string'],
            'mnc'                             => ['required', 'string'],
            'mcc_mnc'                         => ['required', 'string'],
            'product_type'                    => ['nullable', 'string'],
            'product_type_dropdown_item_id'   => ['nullable', 'integer'],
            'known_hops_dropdown_item_id'     => ['nullable', 'integer'],
            'sender_id_supported_dropdown_item_id' => ['nullable', 'integer'],
            'route_type_id'                   => ['nullable', 'integer'],
            'charge_model_id'                 => ['nullable', 'integer'],
            'charge_type'                     => ['nullable', 'string'],
            'is_exclusive'                    => ['nullable'],
            'effective_date'                  => ['nullable', 'date'],
        ]);

        $data['is_exclusive'] = $request->boolean('is_exclusive');

        SupplierOffer::create($data);

        return redirect()
            ->route('offers.index')
            ->with('status', 'Offer created');
    }

    /**
     * Show edit form.
     */
    public function edit(SupplierOffer $offer)
    {
        $countries   = Country::orderBy('name')->get();
        $suppliers   = Supplier::orderBy('name')->get();
        $networks    = Network::orderBy('name')->get();
        $connections = SupplierConnection::orderBy('name')->get();

        $productTypeItems        = DropdownItem::where('dropdown_menu_id', 1)->orderBy('label')->get();
        $knownHopsItems          = DropdownItem::where('dropdown_menu_id', 2)->orderBy('label')->get();
        $senderIdSupportedItems  = DropdownItem::where('dropdown_menu_id', 3)->orderBy('label')->get();

        return view('offers.edit', compact(
            'offer',
            'countries',
            'suppliers',
            'networks',
            'connections',
            'productTypeItems',
            'knownHopsItems',
            'senderIdSupportedItems',
        ));
    }

    /**
     * Update offer.
     */
    public function update(Request $request, SupplierOffer $offer)
    {
        $data = $request->validate([
            'country_id'                      => ['required', 'integer'],
            'network_id'                      => ['required', 'integer'],
            'network_mnc_id'                  => ['required', 'integer'],
            'supplier_id'                     => ['required', 'integer'],
            'supplier_connection_id'          => ['required', 'integer'],
            'price'                           => ['required', 'numeric'],
            'mcc'                             => ['required', 'string'],
            'mnc'                             => ['required', 'string'],
            'mcc_mnc'                         => ['required', 'string'],
            'product_type'                    => ['nullable', 'string'],
            'product_type_dropdown_item_id'   => ['nullable', 'integer'],
            'known_hops_dropdown_item_id'     => ['nullable', 'integer'],
            'sender_id_supported_dropdown_item_id' => ['nullable', 'integer'],
            'route_type_id'                   => ['nullable', 'integer'],
            'charge_model_id'                 => ['nullable', 'integer'],
            'charge_type'                     => ['nullable', 'string'],
            'is_exclusive'                    => ['nullable'],
            'effective_date'                  => ['nullable', 'date'],
        ]);

        $data['is_exclusive'] = $request->boolean('is_exclusive');

        $offer->update($data);

        return redirect()
            ->route('offers.index')
            ->with('status', 'Offer updated');
    }

    /**
     * Delete offer.
     */
    public function destroy(SupplierOffer $offer)
    {
        $offer->delete();

        return redirect()
            ->route('offers.index')
            ->with('status', 'Offer deleted');
    }
}
